# Public domains; create A/AAAA DNS records pointing to the Hetzner server.
STOREFRONT_DOMAIN=shop.example.cz
API_DOMAIN=api.example.cz
ACME_EMAIL=admin@example.cz
SITE_NAME=muj-eshop

# Use long randomly-generated values. Never commit the real .env.production.
COOKIE_SECRET=replace-with-at-least-32-random-characters
REVALIDATION_SECRET=replace-with-a-random-secret
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=replace-with-a-strong-unique-password

# PostgreSQL runs inside the private Docker network.
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-database-password

# Vendure channel token.
VENDURE_CHANNEL_TOKEN=__default_channel__

# SMTP provider (Resend, SES SMTP or another production SMTP service).
EMAIL_FROM_ADDRESS="koupelny-eshop <noreply@example.cz>"
EMAIL_ORDER_NOTIFY_ADDRESS=objednavky@example.cz
INVOICE_SELLER_NAME=Sanitrade s.r.o.
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_ICO=
INVOICE_SELLER_DIC=
BANK_ACCOUNT_IBAN=
BANK_ACCOUNT_NAME=Sanitrade s.r.o.
BANK_ACCOUNT_BANK=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Off-site Restic repository on a Hetzner Storage Box.
# Put its SSH private key and known_hosts file in deploy/ssh/ on the server.
RESTIC_REPOSITORY=sftp:storagebox-user@storagebox-host:/home/backups/muj-eshop
RESTIC_PASSWORD=replace-with-a-long-backup-encryption-password

# Optional immutable image tag, e.g. a Git commit SHA.
IMAGE_TAG=latest
