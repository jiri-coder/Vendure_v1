{{> header title=title }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text>
            Dobrý den, {{ order.customer.firstName }} {{ order.customer.lastName }},
        </mj-text>
        <mj-text>
            {{ intro }}
        </mj-text>
        <mj-text>
            Číslo objednávky: <strong>{{ order.code }}</strong>
        </mj-text>
        {{#if showFulfillmentInfo}}
        <mj-text>
            {{ fulfillmentInfo }}
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>

{{#if showInvoice}}
<mj-section>
    <mj-column>
        <mj-text>
            <h3>Daňový doklad{{#if invoiceNumber}} {{ invoiceNumber }}{{/if}}</h3>
            PDF fakturu stáhnete po přihlášení v detailu objednávky.
        </mj-text>
        <mj-button href="{{ orderAccountUrl }}" background-color="#375a67" color="#ffffff">
            Stáhnout fakturu v účtu
        </mj-button>
    </mj-column>
</mj-section>
{{/if}}

{{#if showShipments}}
<mj-section background-color="#fafafa">
    <mj-column>
        {{#if shipments.length}}
        <mj-text>
            <h3>Sledování zásilky</h3>
            {{#each shipments}}
                {{#if method}}Dopravce: {{ method }}<br/>{{/if}}
                {{#if trackingUrl}}
                    Sledovací číslo: <a href="{{ trackingUrl }}">{{#if trackingNumber}}{{ trackingNumber }}{{else}}sledovat zásilku{{/if}}</a><br/>
                {{else}}
                    {{#if trackingNumber}}Sledovací číslo: {{ trackingNumber }}<br/>{{/if}}
                {{/if}}
            {{/each}}
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>
{{/if}}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text>
            Stav objednávky si můžete zkontrolovat ve <a href="{{ orderAccountUrl }}">svém účtu</a>.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
